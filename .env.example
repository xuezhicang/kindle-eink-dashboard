# Copy to .env and fill in:   cp .env.example .env && chmod 600 .env
# .env is private: never commit it.

# Cloudflare Worker that stores the image (HTTP PUT, Bearer token)
UPLOAD_URL=https://your-worker.example.workers.dev/image.png
UPLOAD_TOKEN=

# Weather location for Open-Meteo, decimal degrees (2 decimals ≈ 1 km is enough)
WEATHER_LAT=0.00
WEATHER_LON=0.00
